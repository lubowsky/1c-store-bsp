
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	СсылкаОрг = ПараметрКоманды;
	Если НЕ ЗначениеЗаполнено(СсылкаОрг) Тогда
		ПоказатьОповещениеПользователя("Внимание", , "Сначала необходимо записать организацию!");
		Возврат;
	КонецЕсли;
	
	МассивСчетов = ПолучитьБанковскиеСчетаОрганизации(СсылкаОрг);
	
	Если МассивСчетов.Количество() > 1 Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Отбор", Новый Структура("Владелец", СсылкаОрг));
		СтруктураПараметров.Вставить("ЗакрыватьПриВыборе", Истина);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораСчета", ЭтотОбъект, СсылкаОрг);
	ОткрытьФорму("Справочник.БанковскиеСчета.ФормаВыбора", СтруктураПараметров, ЭтотОбъект, , , , Оповещение);
		
	Иначе
		ВыбранныйСчет = ?(МассивСчетов.Количество() = 1, МассивСчетов[0], Неопределено);
		СформироватьИПоместитьВБуфер(СсылкаОрг, ВыбранныйСчет);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьБанковскиеСчетаОрганизации(СсылкаОрг)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	БанковскиеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Владелец = &Владелец
		|	И НЕ БанковскиеСчета.ПометкаУдаления";
		
	Запрос.УстановитьПараметр("Владелец", СсылкаОрг);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции 

&НаКлиенте
Асинх Процедура СформироватьИПоместитьВБуфер(СсылкаОрг, ВыбранныйСчет)
	ТекстРеквизитов = СформироватьТекстРеквизитовНаСервере(СсылкаОрг, ВыбранныйСчет);	
	
	Если НЕ ПустаяСтрока(ТекстРеквизитов) Тогда		
		ЭлементБуфера = Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, ТекстРеквизитов);		
		Успешно = Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(ЭлементБуфера);
			
		Если Успешно Тогда	
			ПоказатьОповещениеПользователя("Успешно", , "Реквизиты скопированы в буфер обмена!");			
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьСсылкуОрганизацииПоКоду(КодОрганизации)
	Возврат Справочники.Организации.НайтиПоКоду(КодОрганизации);
КонецФункции

&НаСервере
Функция СформироватьТекстРеквизитовНаСервере(СсылкаОрг, ВыбранныйСчет)
	Сведения = ОрганизацииСервер.СведенияОбОрганизации(СсылкаОрг, "ИНН,КПП,НаименованиеПолное,ЮридическийАдрес");
	
	НомерСчета = "";
	Банк = "";
	БИК = "";
	
	Если ЗначениеЗаполнено(ВыбранныйСчет) Тогда
		РеквизитыСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыбранныйСчет, "НомерСчета,Банк");
		НомерСчета = РеквизитыСчета.НомерСчета;
		
		Если ЗначениеЗаполнено(РеквизитыСчета.Банк) Тогда
			РеквизитыБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыСчета.Банк, "Наименование,Код");
			Банк = РеквизитыБанка.Наименование;
			БИК  = РеквизитыБанка.Код;
		КонецЕсли;
	КонецЕсли;
	
	Текст = СтрШаблон(	
		"%1" + Символы.ПС +	
		"Адрес: %2" + Символы.ПС +		
		"ИНН/КПП: %3 / %4" + Символы.ПС +		
		"Расчетный счет: %5" + Символы.ПС +		
		"Банк: %6" + Символы.ПС +		
		"БИК: %7",	
		Сведения.НаименованиеПолное,	
		Сведения.ЮридическийАдрес,	
		Сведения.ИНН,	
		Сведения.КПП,
		НомерСчета,
		Банк,
		БИК
	);
	
	Возврат Текст;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораСчета(РезультатВыбора, СсылкаОрг)	
	Если ЗначениеЗаполнено(РезультатВыбора) Тогда
		СформироватьИПоместитьВБуфер(СсылкаОрг, РезультатВыбора);
	КонецЕсли;
КонецПроцедуры


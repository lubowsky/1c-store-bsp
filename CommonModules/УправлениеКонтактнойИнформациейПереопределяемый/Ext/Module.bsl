	Элемент.Родитель = Справочники.ВидыКонтактнойИнформации.СправочникСклады;
	Элемент.ИмяГруппы = "СправочникСклады";
	Элемент.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
	Элемент.ИмяПредопределенногоВида = "АдресСклада";
	Элемент.ИдентификаторДляФормул = "АдресСклада";
	Элемент.ВидРедактирования = "ПолеВводаИДиалог";
	Элемент.ВключатьСтрануВПредставление = Ложь;
	Элемент.ХранитьИсториюИзменений = Ложь;
	Элемент.ОтображатьВсегда = Истина;
	Элемент.Наименование = НСтр("ru = 'Адрес'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	// Телефон организации
	Элемент = Элементы.Добавить();                        
	Элемент.ИмяПредопределенныхДанных = "ТелефонСклада";
	Элемент.Родитель = Справочники.ВидыКонтактнойИнформации.СправочникСклады;
	Элемент.ИмяГруппы = "СправочникСклады";
	Элемент.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
	Элемент.ИмяПредопределенногоВида = "ТелефонСклада";
	Элемент.ИдентификаторДляФормул = "ТелефонСклада";
	Элемент.ВидРедактирования = "ПолеВводаИДиалог";
	Элемент.ОтображатьВсегда = Истина;
	Элемент.Наименование = НСтр("ru = 'Телефон'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецПроцедуры


// Смотри также ОбновлениеИнформационнойБазыПереопределяемый.ПриНачальномЗаполненииЭлементов
//
// Параметры:
//  КодыЯзыков - см. ОбновлениеИнформационнойБазыПереопределяемый.ПриНачальномЗаполненииЭлементов.КодыЯзыков
//  Элементы   - см. ОбновлениеИнформационнойБазыПереопределяемый.ПриНачальномЗаполненииЭлементов.Элементы
//  ТабличныеЧасти - см. ОбновлениеИнформационнойБазыПереопределяемый.ПриНачальномЗаполненииЭлементов.ТабличныеЧасти
//
Процедура ПриНачальномЗаполненииЭлементов(КодыЯзыков, Элементы, ТабличныеЧасти) Экспорт
	
	 	// Контактная информация справочника "Организации" 
	Элемент = Элементы.Добавить(); 
	Элемент.ИмяПредопределенныхДанных = "СправочникОрганизации";
	Элемент.ИмяПредопределенногоВида = "СправочникОрганизации";
	Элемент.ЭтоГруппа = Истина;
	Элемент.Наименование = НСтр("ru = 'Контактная информация справочника ""Организации""'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	// Юр. адрес организации
	Элемент = Элементы.Добавить();                        
	Элемент.ИмяПредопределенныхДанных = "ЮрАдресОрганизации";
	Элемент.Родитель = Справочники.ВидыКонтактнойИнформации.СправочникОрганизации;
	Элемент.ИмяГруппы = "СправочникОрганизации";
	Элемент.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
	Элемент.ИмяПредопределенногоВида = "ЮрАдресОрганизации";
	Элемент.ИдентификаторДляФормул = "ЮрАдресОрганизации";
	Элемент.ВидРедактирования = "ПолеВводаИДиалог";
	Элемент.ВключатьСтрануВПредставление = Ложь;
	Элемент.ХранитьИсториюИзменений = Ложь;
	Элемент.ОтображатьВсегда = Истина;
	Элемент.Наименование = НСтр("ru = 'Юр. адрес'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	// Факт. адрес организации
	Элемент = Элементы.Добавить();                          
	Элемент.ИмяПредопределенныхДанных = "ФактАдресОрганизации";
	Элемент.Родитель = Справочники.ВидыКонтактнойИнформации.СправочникОрганизации;
	Элемент.ИмяГруппы = "СправочникОрганизации";
	Элемент.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
	Элемент.ИмяПредопределенногоВида = "ФактАдресОрганизации";
	Элемент.ИдентификаторДляФормул = "ФактАдресОрганизации";
	Элемент.ВидРедактирования = "ПолеВводаИДиалог";
	Элемент.ВключатьСтрануВПредставление = Ложь;
	Элемент.ХранитьИсториюИзменений = Ложь;
	Элемент.ОтображатьВсегда = Истина;
	Элемент.Наименование = НСтр("ru = 'Факт. адрес'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	// Телефон организации
	Элемент = Элементы.Добавить();                        
	Элемент.ИмяПредопределенныхДанных = "ТелефонОрганизации";
	Элемент.Родитель = Справочники.ВидыКонтактнойИнформации.СправочникОрганизации;
	Элемент.ИмяГруппы = "СправочникОрганизации";
	Элемент.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
	Элемент.ИмяПредопределенногоВида = "ТелефонОрганизации";
	Элемент.ИдентификаторДляФормул = "ТелефонОрганизации";
	Элемент.ВидРедактирования = "ПолеВводаИДиалог";
	Элемент.ОтображатьВсегда = Истина;
	Элемент.Наименование = НСтр("ru = 'Телефон'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	// Email организации
	Элемент = Элементы.Добавить();                      
	Элемент.ИмяПредопределенныхДанных = "EmailОрганизации";
	Элемент.Родитель = Справочники.ВидыКонтактнойИнформации.СправочникОрганизации;
	Элемент.ИмяГруппы = "СправочникОрганизации";
	Элемент.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	Элемент.ИмяПредопределенногоВида = "EmailОрганизации";
	Элемент.ИдентификаторДляФормул = "EmailОрганизации";
	Элемент.ВидРедактирования = "ПолеВвода";
	Элемент.ОтображатьВсегда = Истина;
	Элемент.Наименование = НСтр("ru = 'Email'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	// Сайт организации
	Элемент = Элементы.Добавить();                     
	Элемент.ИмяПредопределенныхДанных = "СайтОрганизации";
	Элемент.Родитель = Справочники.ВидыКонтактнойИнформации.СправочникОрганизации;
	Элемент.ИмяГруппы = "СправочникОрганизации";
	Элемент.Тип = Перечисления.ТипыКонтактнойИнформации.ВебСтраница;
	Элемент.ИмяПредопределенногоВида = "СайтОрганизации";
	Элемент.ИдентификаторДляФормул = "СайтОрганизации";
	Элемент.ВидРедактирования = "ПолеВвода";
	Элемент.ОтображатьВсегда = Истина;
	Элемент.Наименование = НСтр("ru = 'Сайт'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	// Контактная информация справочника "Склады" 
	Элемент = Элементы.Добавить(); 
	Элемент.ИмяПредопределенныхДанных = "СправочникСклады";
	Элемент.ИмяПредопределенногоВида = "СправочникСклады";
	Элемент.ЭтоГруппа = Истина;
	Элемент.Наименование = НСтр("ru = 'Контактная информация справочника ""Склады""'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	// Юр. адрес организации
